# FaceTime HD: lift brightness a little; the ISP meters the whole frame, so a
# backlit subject comes out dark at the 128 default. Change the value to taste.
ACTION=="add", SUBSYSTEM=="video4linux", KERNEL=="video[0-9]*", \
  ATTRS{vendor}=="0x14e4", ATTRS{device}=="0x1570", \
  RUN+="/usr/bin/v4l2-ctl -d $devnode --set-ctrl=brightness=155"
